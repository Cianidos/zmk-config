#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Base mouse movement - accelerated, slightly faster than default

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};

// Set up input processors for different modifier speeds

&mmv_input_listener {
    mouse_slow {
        layers = <4>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    mouse_medium {
        layers = <5>;
        input-processors = <&zip_xy_scaler 3 2>;
    };

    mouse_fast {
        layers = <6>;
        input-processors = <&zip_xy_scaler 5 2>;
    };

    mouse_faster {
        layers = <7>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

&msc_input_listener {
    mouse_slow {
        layers = <4>;
        input-processors = <&zip_xy_scaler 1 10>;
    };

    mouse_medium {
        layers = <5>;
        input-processors = <&zip_xy_scaler 3 1>;
    };

    mouse_fast {
        layers = <6>;
        input-processors = <&zip_xy_scaler 5 1>;
    };

    mouse_faster {
        layers = <7>;
        input-processors = <&zip_xy_scaler 10 1>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        /**
            * Temporarily switches to a layer (&mo) while a modifier is held.
            * Analogous to QMK's LM(), using a parameterized macro.
            *
            * Params:
            * 1. Layer to switch to
            * 2. Modifier to press while layer is active
            *
            * Example:
            * &lm NUM_LAYER LSHIFT
            */

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
        };

        // Toggle OS input method (Caps Lock)
        lang_tog: lang_tog {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp CAPSLOCK>;
        };

        // Switch to English: flip hw layer then notify OS
        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&to 0>, <&lang_tog>;
        };

        // Switch to Russian: flip hw layer then notify OS
        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&to 9>, <&lang_tog>;
        };

        // Type one key in English while OS is in Russian:
        // toggle OS to EN, hold key, release key, toggle OS back to RU.
        en_key: en_key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms = <30>;
            bindings =
                <&macro_tap>, <&lang_tog>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>, <&lang_tog>;
        };
    };

    behaviors {
        // Home row mods — left hand (triggers on right-side keys only)
        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <20>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 54 55 56 57 48 49 52 53>;
            hold-trigger-on-release;
        };

        // Home row mods — right hand (triggers on left-side keys only)
        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <20>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 42 54 55>;
            hold-trigger-on-release;
        };

        // Bottom row mods — left hand
        brml: brml {
            compatible = "zmk,behavior-hold-tap";
            label = "BRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <20>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 54 55 56 57 48 49 52 53>;
            hold-trigger-on-release;
        };

        // Bottom row mods — right hand
        brmr: brmr {
            compatible = "zmk,behavior-hold-tap";
            label = "BRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <20>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 42 54 55>;
            hold-trigger-on-release;
        };

        // Layer-tap for thumb keys — left
        cltl: cltl {
            compatible = "zmk,behavior-hold-tap";
            label = "CLTL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <20>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 54 55 56 57 48 49 52 53>;
        };

        // Layer-tap for thumb keys — right
        cltr: cltr {
            compatible = "zmk,behavior-hold-tap";
            label = "CLTR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <20>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 42 54 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Colemak-DH, home row mods (GUI/ALT/CTRL/SHIFT), thumb layer-taps
        base {
            bindings = <
&trans  &trans             &trans             &trans                 &trans               &trans                             &trans           &trans               &trans                     &trans               &trans                &trans
&trans  &kp Q              &kp W              &kp F                  &kp P                &kp B                              &kp J            &kp L                &kp U                      &kp Y                &kp SQT               &trans
&layer_ru  &hrml LEFT_GUI A   &hrml LEFT_ALT R   &hrml LEFT_CONTROL S   &hrml LEFT_SHIFT T   &kp G                              &kp M            &hrmr LEFT_SHIFT N   &hrmr LEFT_CONTROL E       &hrmr LEFT_ALT I     &hrmr LEFT_GUI O      &trans
&trans  &brml RIGHT_GUI Z  &brml RIGHT_ALT X  &brml RIGHT_CONTROL C  &brml RIGHT_SHIFT D  &kp V        &tog 8       &trans   &kp K            &brmr RIGHT_SHIFT H  &brmr RIGHT_CONTROL COMMA  &brmr RIGHT_ALT DOT  &brmr RIGHT_GUI FSLH  &trans
                                              &trans                 &kp ESCAPE           &lt 2 SPACE  &lt 3 TAB    &kp RET  &lt 1 BACKSPACE  &kp DELETE           &trans
            >;

            label = "Base";
        };

        // Numbers, brackets, F-keys; right thumb activates
        nums {
            bindings = <
&studio_unlock  &trans     &trans  &trans  &trans  &trans                          &kp F1  &kp F2          &kp F3            &kp F4        &kp F5        &kp F6
&trans          &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT                        &kp F7  &kp F8          &kp F9            &kp F10       &kp F11       &kp F12
&trans          &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL                       &trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans          &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH   &trans       &trans  &trans  &trans          &trans            &trans        &trans        &trans
                                   &trans  &kp N0  &kp SPACE  &kp MINUS    &trans  &trans  &trans          &trans
            >;

            label = "Nums";
        };

        // Navigation, undo/redo/cut/copy/paste, caps-word, BT/output; left thumb activates
        arrows {
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                       &out OUT_TOG   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
&trans  &trans        &kp K_REDO    &trans            &kp K_PASTE     &trans                       &trans         &trans        &kp K_UNDO    &kp K_COPY    &trans        &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                       &caps_word     &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp K_APP
&trans  &trans        &trans        &trans            &kp K_CUT       &trans  &trans    &trans     &trans         &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &trans
                                    &trans            &trans          &trans  &trans    &kp ENTER  &kp BACKSPACE  &kp DELETE    &trans
            >;

            label = "Arrows";
        };

        // Mouse move/scroll/buttons, media, brightness; left thumb activates. Bottom row selects speed sub-layer.
        mouse {
            bindings = <
&trans  &trans        &trans        &trans            &trans          &trans                      &kp C_MUTE    &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PREV    &kp C_PP         &kp C_NEXT
&trans  &trans        &trans        &trans            &trans          &trans                      &kp C_BRI_UP  &trans          &trans          &trans        &trans           &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                      &kp C_BRI_DN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &mo 4         &mo 5         &mo 6             &mo 7           &trans  &trans    &trans    &trans        &msc MOVE_LEFT  &msc MOVE_DOWN  &msc MOVE_UP  &msc MOVE_RIGHT  &trans
                                    &trans            &trans          &trans  &trans    &mkp MB1  &mkp MB2      &mkp MB3        &trans
            >;

            label = "Mouse";
        };

        // Speed sub-layers: fully transparent — movement keys fall through to Mouse.
        // Input processors in mmv_input_listener/msc_input_listener key off the active layer number.
        mouse_slow   { bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>; label = "Mouse Slow"; };
        mouse_medium { bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>; label = "Mouse Medium"; };
        mouse_fast   { bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>; label = "Mouse Fast"; };
        mouse_faster { bindings = <&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>; label = "Mouse Faster"; };

        // Standard QWERTY for gaming; toggled with &tog 8
        gaming {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4        &kp N5                                &kp N6    &kp N7      &kp N8     &kp N9   &kp N0    &trans
&kp TAB    &kp Q   &kp W   &kp E   &kp R         &kp T                                 &kp Y     &kp U       &kp I      &kp O    &kp P     &trans
&kp LCTRL  &kp A   &kp S   &kp D   &kp F         &kp G                                 &kp H     &kp J       &kp K      &kp L    &kp SEMI  &trans
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V         &kp B      &trans          &trans     &kp N     &kp M       &kp COMMA  &kp DOT  &kp FSLH  &trans
                           &trans  &kp LEFT_ALT  &kp SPACE  &kp LEFT_GUI    &kp ENTER  &kp BSPC  &kp DELETE  &trans
            >;

            label = "Gaming";
        };

        // Russian layer — Colemak-DH phonetic (ЯШЕРТЫ scheme)
        //   Each key sends the QWERTY keycode that, through OS йцукен layout,
        //   produces the phonetically matching Cyrillic letter.
        //   Caps Lock toggles OS language.  Extra letters (Ъ Ё Ч) on ru_nums.
        // Home row: А Р С Т Г | М Н Е И О
        ru {
            display-name = "Ru";
            bindings = <
&trans     &trans              &trans               &trans                 &trans               &trans                               &trans   &trans               &trans                  &trans              &trans               &trans
&trans     &kp Z               &kp I                &kp A                  &kp G                &kp COMMA                            &kp Q    &kp K                &kp E                   &kp S               &kp SQT              &trans
&layer_en  &hrml LEFT_GUI F    &hrml LEFT_ALT H     &hrml LEFT_CONTROL C   &hrml LEFT_SHIFT N   &kp U                                &kp V    &hrmr LEFT_SHIFT Y   &hrmr LEFT_CONTROL T    &hrmr LEFT_ALT B    &hrmr LEFT_GUI J     &trans
&trans     &brml RIGHT_GUI P   &brml RIGHT_ALT O    &brml RIGHT_CONTROL W  &brml RIGHT_SHIFT L  &kp D       &tog 8       &trans      &kp R    &brmr RIGHT_SHIFT LBKT  &brmr RIGHT_CONTROL SEMI  &brmr RIGHT_ALT DOT  &brmr RIGHT_GUI M  &trans
                                                    &trans                 &kp ESCAPE           &lt 2 SPACE  &lt 3 TAB   &kp RET     &lt 10 BACKSPACE  &kp DELETE  &trans
            >;
        };

        // Numbers layer for RU mode — same as nums but symbol keys
        // replaced with extra Cyrillic letters not on the base RU layer:
        //   Ъ (RBKT), Ё (GRAVE), Ч (X)
        ru_nums {
            display-name = "RuNums";
            bindings = <
&trans  &trans      &trans   &trans   &trans   &trans                          &kp F1  &kp F2          &kp F3            &kp F4        &kp F5        &kp F6
&trans  &kp RBKT    &kp N7   &kp N8   &kp N9   &kp X                           &kp F7  &kp F8          &kp F9            &kp F10       &kp F11       &kp F12
&trans  &kp GRAVE   &kp N4   &kp N5   &kp N6   &trans                          &trans  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &trans
&trans  &trans      &kp N1   &kp N2   &kp N3   &trans     &trans       &trans  &trans  &trans          &trans            &trans        &trans        &trans
                             &trans   &kp N0   &kp SPACE  &kp MINUS    &trans  &trans  &trans          &trans
            >;
        };
    };
};

// Local Variables:
// mode: c++
// eval: (apheleia-mode -1)
// End:
