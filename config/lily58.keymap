#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        home_raw_mod_left: home_raw_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_RAW_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <35 34 33 32>;
        };

        home_row_mod_right: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <24 25 26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&trans                         &trans                         &trans                             &trans                           &trans      &trans                           &studio_unlock  &out OUT_TOG  &bt BT_SEL 0                       &bt BT_SEL 1                         &bt BT_SEL 2                     &bt BT_SEL 3
&kp Q                          &kp W                          &kp F                              &kp P                            &kp G       &trans                           &trans          &kp J         &kp L                              &kp U                                &kp Y                            &kp SEMI
&home_raw_mod_left LEFT_GUI A  &home_raw_mod_left LEFT_ALT R  &home_raw_mod_left LEFT_CONTROL S  &home_raw_mod_left LEFT_SHIFT T  &kp D       &trans                           &trans          &kp H         &home_row_mod_right RIGHT_SHIFT N  &home_row_mod_right RIGHT_CONTROL E  &home_row_mod_right RIGHT_ALT I  &home_row_mod_right RIGHT_GUI O
&kp Z                          &kp X                          &kp C                              &kp V                            &kp B       &trans     &trans     &trans     &trans          &kp K         &kp M                              &kp COMMA                            &kp DOT                          &kp FSLH
                                                                                                 &trans                           &kp ESCAPE  &kp SPACE  &kp TAB    &kp ENTER  &kp BACKSPACE   &mo 1         &trans
            >;
        };

        layer_1 {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4        &kp F5                &kp F6                                   &kp F7                &kp F8                &kp F9            &kp F10     &kp F11            &kp F12
&kp LBKT   &kp N7  &kp N8  &kp N9        &kp RBKT              &kp LG(LS(NUMBER_5))                     &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &trans            &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp SEMI   &kp N4  &kp N5  &kp N6        &kp EQUAL             &kp LG(LS(NUMBER_4))                     &trans                &kp LEFT              &kp DOWN          &kp UP      &kp RIGHT          &trans
&kp GRAVE  &kp N1  &kp N2  &kp N3        &kp BSLH              &kp LG(LS(NUMBER_4))   &trans    &trans  &trans                &kp C_PREVIOUS        &kp C_PLAY_PAUSE  &kp C_NEXT  &trans             &trans
                           &kp NUMBER_0  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans  &trans                &trans                &trans
            >;
        };
    };
};
