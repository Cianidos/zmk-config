#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Base mouse movement - accelerated, slightly faster than default
&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

// Set up input processors for different modifier speeds
&mmv_input_listener {
    mouse_slow {
        layers = <4>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    mouse_medium {
        layers = <5>;
        input-processors = <&zip_xy_scaler 3 2>;
    };

    mouse_fast {
        layers = <6>;
        input-processors = <&zip_xy_scaler 5 2>;
    };

    mouse_faster {
        layers = <7>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};


&msc_input_listener {
    mouse_slow {
        layers = <4>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    mouse_medium {
        layers = <5>;
        input-processors = <&zip_xy_scaler 3 2>;
    };

    mouse_fast {
        layers = <6>;
        input-processors = <&zip_xy_scaler 5 2>;
    };

    mouse_faster {
        layers = <7>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        /**
            * Temporarily switches to a layer (&mo) while a modifier is held.
            * Analogous to QMK's LM(), using a parameterized macro.
            *
            * Params:
            * 1. Layer to switch to
            * 2. Modifier to press while layer is active
            *
            * Example:
            * &lm NUM_LAYER LSHIFT
            */

        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            // global-quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 54 55 56 57 48 49 52 53>;
            // hold-trigger-on-release;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            // global-quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 42 54 55>;
            // hold-trigger-on-release; // REMOVED
        };

        // custom layer tap left
        cltl: cltl {
            compatible = "zmk,behavior-hold-tap";
            label = "CLTL";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            // global-quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 54 55 56 57 48 49 52 53>;
            // hold-trigger-on-release;
        };

        // custom layer tap right
        cltr: cltr {
            compatible = "zmk,behavior-hold-tap";
            label = "CLTR";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            // global-quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 42 54 55>;
            // hold-trigger-on-release; // REMOVED
        };
    };


    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&trans  &trans            &trans            &trans                &trans              &trans                                &trans           &trans              &trans                &trans            &trans            &trans
&trans  &kp Q             &kp W             &kp F                 &kp P               &kp B                                 &kp J            &kp L               &kp U                 &kp Y             &kp SQT           &trans
&trans  &hrml LEFT_GUI A  &hrml LEFT_ALT R  &hrml LEFT_CONTROL S  &hrml LEFT_SHIFT T  &kp G                                 &kp M            &hrmr LEFT_SHIFT N  &hrmr LEFT_CONTROL E  &hrmr LEFT_ALT I  &hrmr LEFT_GUI O  &trans
&trans  &kp Z             &kp X             &kp C                 &kp D               &kp V          &tog 8        &trans   &kp K            &kp H               &kp COMMA             &kp DOT           &kp FSLH          &trans
                                            &trans                &kp ESCAPE          &lt 2 SPACE    &lt 3 TAB     &kp RET  &lt 1 BACKSPACE  &kp DELETE          &trans
            >;

            label = "Base";
        };

        nums {
            bindings = <
&studio_unlock  &trans     &trans  &trans  &trans   &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBKT                        &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp SEMI   &kp N4  &kp N5  &kp N6   &kp EQUAL                       &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BSLH   &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                   &trans  &kp N0   &kp SPACE  &kp MINUS    &trans  &trans  &trans  &trans
            >;

            label = "Nums";
        };

        arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &out OUT_TOG   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans                       &trans         &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &caps_word     &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp K_APP
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans         &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &trans
                        &trans  &trans  &trans  &trans    &kp ENTER  &kp BACKSPACE  &kp DELETE    &trans
            >;

            label = "Arrows";
        };

        mouse {
            bindings = <
&trans  &trans       &trans       &trans           &trans         &trans                      &kp C_MUTE    &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PREV    &kp C_PP         &kp C_NEXT
&trans  &trans       &trans       &trans           &trans         &trans                      &kp C_BRI_UP  &trans          &trans          &trans        &trans           &trans
&trans  &kp LEFT_GUI &kp LEFT_ALT &kp LEFT_CONTROL &kp LEFT_SHIFT &trans                      &kp C_BRI_DN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &mo 4        &mo 5        &mo 6            &mo 7          &trans  &trans    &trans    &trans        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                  &trans           &trans         &trans  &trans    &mkp MB1  &mkp MB2      &mkp MB3        &trans
            >;

            label = "Mouse";
        };

        mouse_slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB2  &mkp MB3        &trans
            >;

            label = "Mouse Slow";
        };

        mouse_medium {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB2  &mkp MB3        &trans
            >;

            label = "Mouse Medium";
        };

        mouse_fast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB2  &mkp MB3        &trans
            >;

            label = "Mouse Fast";
        };

        mouse_faster {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans  &trans    &mkp MB1  &mkp MB2  &mkp MB3        &trans
            >;

            label = "Mouse Faster";
        };

        gaming {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4        &kp N5                                &kp N6    &kp N7      &kp N8     &kp N9   &kp N0    &trans
&kp TAB    &kp Q   &kp W   &kp E   &kp R         &kp T                                 &kp Y     &kp U       &kp I      &kp O    &kp P     &trans
&kp LCTRL  &kp A   &kp S   &kp D   &kp F         &kp G                                 &kp H     &kp J       &kp K      &kp L    &kp SEMI  &trans
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V         &kp B      &trans          &trans     &kp N     &kp M       &kp COMMA  &kp DOT  &kp FSLH  &trans
                           &trans  &kp LEFT_ALT  &kp SPACE  &kp LEFT_GUI    &kp ENTER  &kp BSPC  &kp DELETE  &trans
            >;

            label = "Gaming";
        };
    };
};

// Local Variables:
// mode: c++
// eval: (apheleia-mode -1)
// End:
